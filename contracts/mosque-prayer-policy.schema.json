{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/mosque-prayer-policy.schema.json",
  "title": "Approved mosque-local prayer display policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "mosque_id", "valid_from", "valid_to", "dhuhr_adhan_source", "dhuhr_replaced_by_jumuah_friday", "iqamah_rules", "jumuah_sessions", "ramadan_exceptions", "holiday_exceptions", "correction_owner"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "policy_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "mosque_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "valid_from": { "$ref": "#/$defs/date" },
    "valid_to": { "$ref": "#/$defs/date" },
    "dhuhr_adhan_source": { "enum": ["dhuhr_onset", "dhuhr_congregation"] },
    "dhuhr_replaced_by_jumuah_friday": { "type": "boolean" },
    "iqamah_rules": { "type": "array", "items": { "$ref": "#/$defs/iqamahRule" } },
    "jumuah_sessions": { "type": "array", "items": { "$ref": "#/$defs/jumuahSession" } },
    "ramadan_exceptions": { "enum": ["", "none"] },
    "holiday_exceptions": { "enum": ["", "none"] },
    "correction_owner": { "enum": ["", "admin"] }
  },
  "$defs": {
    "date": { "type": "string", "format": "date" },
    "time": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "iqamahRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prayer", "valid_from", "valid_to", "weekdays", "priority", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "prayer": { "enum": ["fajr", "dhuhr", "asr", "maghrib", "isha"] },
        "valid_from": { "$ref": "#/$defs/date" },
        "valid_to": { "$ref": "#/$defs/date" },
        "weekdays": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 7 } },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "offset_minutes"],
          "properties": {
            "mode": { "const": "offset_after_adhan" },
            "offset_minutes": { "type": "integer", "minimum": 0, "maximum": 240 }
          }
        },
        "reason": { "type": "string", "maxLength": 1000 }
      }
    },
    "jumuahSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "salah_time", "valid_from", "valid_to"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "khutbah_time": { "$ref": "#/$defs/time" },
        "salah_time": { "$ref": "#/$defs/time" },
        "valid_from": { "$ref": "#/$defs/date" },
        "valid_to": { "$ref": "#/$defs/date" }
      }
    }
  }
}

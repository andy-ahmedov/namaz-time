{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/publication-signing-request.schema.json",
  "title": "Isolated snapshot signing request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "environment", "trust_bundle_revision", "trust_bundle_sha256", "signing_key_id", "canonical_sha256", "canonical_payload_base64", "candidate_id", "raw_sha256", "transcription_sha256", "normalized_sha256", "diff_sha256", "parser_version", "approval_id", "approver_identity", "approved_at", "approval_scope", "unsigned_snapshot"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_id": { "type": "string", "pattern": "^signing-[0-9a-f]{32}$" },
    "environment": { "enum": ["test", "staging", "production"] },
    "trust_bundle_revision": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "trust_bundle_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signing_key_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "canonical_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "canonical_payload_base64": { "type": "string", "minLength": 4 },
    "candidate_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "raw_sha256": { "$ref": "#/$defs/sha256" },
    "transcription_sha256": { "$ref": "#/$defs/sha256" },
    "normalized_sha256": { "$ref": "#/$defs/sha256" },
    "diff_sha256": { "$ref": "#/$defs/sha256" },
    "parser_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "approval_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "approver_identity": { "type": "string", "minLength": 1, "maxLength": 240 },
    "approved_at": { "$ref": "#/$defs/canonicalTimestamp" },
    "approval_scope": { "type": "string", "minLength": 1, "maxLength": 500 },
    "unsigned_snapshot": {
      "type": "object",
      "description": "A prayer snapshot with an empty signature; the publisher strictly decodes and recomputes it before finalization."
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "canonicalTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}

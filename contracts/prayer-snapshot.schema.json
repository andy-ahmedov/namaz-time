{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/prayer-snapshot.schema.json",
  "title": "Mosque Prayer TV signed snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "data_classification",
    "generated_at",
    "mosque",
    "source",
    "coverage",
    "prayer_days",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.0", "2.0"]
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "data_classification": {
      "enum": ["production", "synthetic"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "mosque": {
      "$ref": "#/$defs/mosque"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "coverage": {
      "$ref": "#/$defs/dateRange"
    },
    "prayer_days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 400,
      "items": {
        "$ref": "#/$defs/prayerDay"
      }
    },
    "iqamah_rules": {
      "type": "array",
      "default": [],
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/iqamahRule"
      }
    },
    "iqamah_date_overrides": {
      "type": "array",
      "default": [],
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/iqamahOverride"
      }
    },
    "jumuah_sessions": {
      "type": "array",
      "default": [],
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/jumuahSession"
      }
    },
    "campaigns": {
      "type": "array",
      "default": [],
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/campaign"
      }
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": "1.0" } }, "required": ["schema_version"] },
      "then": { "properties": { "source": { "required": ["approval"], "not": { "required": ["qualification"] } } } },
      "else": {
        "properties": {
          "source": { "required": ["qualification", "canonical_url"], "not": { "anyOf": [{ "required": ["approval"] }, { "required": ["calculation_profile"] }] } },
          "iqamah_rules": { "maxItems": 0 },
          "iqamah_date_overrides": { "maxItems": 0 },
          "jumuah_sessions": { "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "qualificationSHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "qualificationID": { "type": "string", "minLength": 1, "maxLength": 128 },
    "qualificationURL": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
    "qualificationTimestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "sourceQualification": {
      "type": "object",
      "additionalProperties": false,
      "description": "NamazTime exact first-party source qualification, not external endorsement. SHA-256 covers sorted-key canonical JSON excluding qualification_id and sha256; onset_sha256 binds the entire canonical prayer_days array. Semantic/catalog/hash checks are additional mandatory runtime gates.",
      "required": ["schema_version", "qualification_id", "state", "decision_system", "qualified_at", "authority", "source_id", "source_kind", "canonical_url", "scope", "catalog_revision", "timezone", "coverage", "fresh_through", "artifact", "retrieval", "parser_version", "candidate_id", "normalized_sha256", "onset_sha256", "transcription_sha256", "diff_sha256", "validation_sha256", "validated_days", "terms_assessment", "evidence", "comparisons", "sha256"],
      "properties": {
        "schema_version": { "const": "namaztime-source-qualification/v1" },
        "qualification_id": { "type": "string", "pattern": "^qualification-[a-f0-9]{32}$" },
        "state": { "const": "qualified" },
        "decision_system": { "const": "namaztime:source-qualification/v1" },
        "qualified_at": { "$ref": "#/$defs/qualificationTimestamp" },
        "authority": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "website", "evidence_label"],
          "properties": {
            "id": { "$ref": "#/$defs/qualificationID" },
            "name": { "type": "string", "minLength": 1, "maxLength": 240 },
            "branch": { "type": "string", "minLength": 1, "maxLength": 240 },
            "website": { "$ref": "#/$defs/qualificationURL" },
            "evidence_label": { "const": "CONFIRMED_PUBLIC" }
          }
        },
        "source_id": { "$ref": "#/$defs/qualificationID" },
        "source_kind": { "enum": ["official_api", "official_file", "official_html", "mosque_calendar"] },
        "canonical_url": { "$ref": "#/$defs/qualificationURL" },
        "scope": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "region_id", "description"],
          "properties": {
            "id": { "$ref": "#/$defs/qualificationID" },
            "kind": { "enum": ["city", "region"] },
            "city_id": { "$ref": "#/$defs/qualificationID" },
            "region_id": { "$ref": "#/$defs/qualificationID" },
            "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
          },
          "allOf": [{
            "if": { "properties": { "kind": { "const": "city" } }, "required": ["kind"] },
            "then": { "required": ["city_id"] },
            "else": { "not": { "required": ["city_id"] } }
          }]
        },
        "catalog_revision": { "$ref": "#/$defs/qualificationID" },
        "timezone": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "/" },
        "coverage": { "$ref": "#/$defs/dateRange" },
        "fresh_through": { "$ref": "#/$defs/localDate" },
        "artifact": {
          "type": "object", "additionalProperties": false,
          "required": ["filename", "content_type", "captured_at", "byte_length", "sha256"],
          "properties": {
            "filename": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "content_type": { "type": "string", "minLength": 1, "maxLength": 240 },
            "captured_at": { "$ref": "#/$defs/qualificationTimestamp" },
            "byte_length": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
            "sha256": { "$ref": "#/$defs/qualificationSHA256" }
          }
        },
        "retrieval": {
          "type": "object", "additionalProperties": false,
          "required": ["url", "http_status", "content_type"],
          "properties": {
            "url": { "$ref": "#/$defs/qualificationURL" },
            "http_status": { "const": 200 },
            "content_type": { "type": "string", "minLength": 1, "maxLength": 240 },
            "etag": { "type": "string", "maxLength": 1024 },
            "last_modified": { "type": "string", "maxLength": 128 }
          }
        },
        "parser_version": { "$ref": "#/$defs/qualificationID" },
        "candidate_id": { "$ref": "#/$defs/qualificationID" },
        "normalized_sha256": { "$ref": "#/$defs/qualificationSHA256" },
        "onset_sha256": { "$ref": "#/$defs/qualificationSHA256" },
        "transcription_sha256": { "$ref": "#/$defs/qualificationSHA256" },
        "diff_sha256": { "$ref": "#/$defs/qualificationSHA256" },
        "validation_sha256": { "$ref": "#/$defs/qualificationSHA256" },
        "validated_days": { "type": "integer", "minimum": 1, "maximum": 400 },
        "terms_assessment": { "enum": ["public_transport_no_restriction_observed", "public_transport_attribution_required"] },
        "evidence": {
          "type": "array", "minItems": 6, "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "purpose", "label", "url", "retrieved_at", "sha256", "claim"],
            "properties": {
              "id": { "$ref": "#/$defs/qualificationID" },
              "purpose": { "enum": ["ownership", "scope", "currentness", "terms", "time_semantics", "value_comparison", "seasonal_transition", "authority_chain"] },
              "label": { "const": "CONFIRMED_PUBLIC" },
              "url": { "$ref": "#/$defs/qualificationURL" },
              "retrieved_at": { "$ref": "#/$defs/qualificationTimestamp" },
              "sha256": { "$ref": "#/$defs/qualificationSHA256" },
              "claim": { "type": "string", "minLength": 1, "maxLength": 4000 }
            }
          }
        },
        "comparisons": {
          "type": "array", "minItems": 1, "maxItems": 400,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["evidence_id", "day"],
            "properties": {
              "evidence_id": { "$ref": "#/$defs/qualificationID" },
              "day": {
                "type": "object", "additionalProperties": false,
                "required": ["date", "fajr", "sunrise", "dhuhr", "asr", "maghrib", "isha"],
                "properties": {
                  "date": { "$ref": "#/$defs/localDate" },
                  "fajr": { "$ref": "#/$defs/localTime" },
                  "sunrise": { "$ref": "#/$defs/localTime" },
                  "dhuhr": { "$ref": "#/$defs/localTime" },
                  "asr": { "$ref": "#/$defs/localTime" },
                  "maghrib": { "$ref": "#/$defs/localTime" },
                  "isha": { "$ref": "#/$defs/localTime" }
                }
              }
            }
          }
        },
        "warning_resolutions": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "evidence_id", "reason"],
            "properties": {
              "code": { "$ref": "#/$defs/qualificationID" },
              "evidence_id": { "$ref": "#/$defs/qualificationID" },
              "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
            }
          }
        },
        "unknowns": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "sha256": { "$ref": "#/$defs/qualificationSHA256" }
      }
    },
    "localDate": {
      "type": "string",
      "format": "date"
    },
    "localTime": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "prayer": {
      "enum": ["fajr", "dhuhr", "asr", "maghrib", "isha"]
    },
    "dateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/localDate" },
        "to": { "$ref": "#/$defs/localDate" }
      }
    },
    "mosque": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "timezone"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "region": { "type": "string", "maxLength": 240 },
        "locality": { "type": "string", "maxLength": 240 },
        "timezone": { "type": "string", "minLength": 3, "maxLength": 64 }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approval_id", "approved_by", "approved_at", "approval_scope"],
      "properties": {
        "status": { "const": "approved" },
        "approval_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "approved_by": { "type": "string", "minLength": 1, "maxLength": 240 },
        "approved_at": { "type": "string", "format": "date-time" },
        "approval_scope": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "note": { "type": "string", "maxLength": 2000 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "kind",
        "authority_name",
        "geographic_scope",
        "retrieved_at",
        "effective_from",
        "effective_to",
        "raw_sha256",
        "parser_version"
      ],
      "properties": {
        "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": {
          "enum": [
            "official_api",
            "official_file",
            "official_html",
            "mosque_calendar",
            "calculation_profile",
            "manual_import"
          ]
        },
        "authority_name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "authority_branch": { "type": "string", "maxLength": 240 },
        "geographic_scope": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "canonical_url": { "type": "string", "format": "uri" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "effective_from": { "$ref": "#/$defs/localDate" },
        "effective_to": { "$ref": "#/$defs/localDate" },
        "raw_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "parser_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "calculation_profile": { "type": "string", "minLength": 1, "maxLength": 240 },
        "license_reference": { "type": "string", "maxLength": 1000 },
        "attribution": { "type": "string", "maxLength": 1000 },
        "approval": { "$ref": "#/$defs/approval" },
        "qualification": { "$ref": "#/$defs/sourceQualification" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "calculation_profile" } },
            "required": ["kind"]
          },
          "then": { "required": ["calculation_profile"] }
        }
      ]
    },
    "prayerDay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "fajr", "sunrise", "dhuhr", "asr", "maghrib", "isha"],
      "properties": {
        "date": { "$ref": "#/$defs/localDate" },
        "fajr": { "$ref": "#/$defs/localTime" },
        "sunrise": { "$ref": "#/$defs/localTime" },
        "dhuhr": { "$ref": "#/$defs/localTime" },
        "asr": { "$ref": "#/$defs/localTime" },
        "maghrib": { "$ref": "#/$defs/localTime" },
        "isha": { "$ref": "#/$defs/localTime" },
        "duha": { "$ref": "#/$defs/localTime" },
        "middle_of_night": { "$ref": "#/$defs/localTime" },
        "last_third_of_night": { "$ref": "#/$defs/localTime" },
        "flags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 128 }
        }
      }
    },
    "iqamahValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "fixed_time"],
          "properties": {
            "mode": { "const": "fixed_time" },
            "fixed_time": { "$ref": "#/$defs/localTime" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "offset_minutes"],
          "properties": {
            "mode": { "const": "offset_after_adhan" },
            "offset_minutes": { "type": "integer", "minimum": 0, "maximum": 240 }
          }
        }
      ]
    },
    "iqamahRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prayer", "valid_from", "valid_to", "weekdays", "priority", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "prayer": { "$ref": "#/$defs/prayer" },
        "valid_from": { "$ref": "#/$defs/localDate" },
        "valid_to": { "$ref": "#/$defs/localDate" },
        "weekdays": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 7 }
        },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "value": { "$ref": "#/$defs/iqamahValue" },
        "reason": { "type": "string", "maxLength": 1000 }
      }
    },
    "iqamahOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "prayer", "value"],
      "properties": {
        "date": { "$ref": "#/$defs/localDate" },
        "prayer": { "$ref": "#/$defs/prayer" },
        "value": { "$ref": "#/$defs/iqamahValue" },
        "reason": { "type": "string", "maxLength": 1000 }
      }
    },
    "jumuahSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "salah_time", "valid_from", "valid_to"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "khutbah_time": { "$ref": "#/$defs/localTime" },
        "salah_time": { "$ref": "#/$defs/localTime" },
        "valid_from": { "$ref": "#/$defs/localDate" },
        "valid_to": { "$ref": "#/$defs/localDate" }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "url", "title", "starts_at", "ends_at", "placement"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "enum": ["donation", "website", "telegram", "schedule", "contacts", "custom"] },
        "url": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://[^/@]+(?:[/:?#]|$)" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "subtitle": { "type": "string", "maxLength": 500 },
        "starts_at": { "type": "string", "format": "date-time" },
        "ends_at": { "type": "string", "format": "date-time" },
        "placement": { "enum": ["always", "with_prayer_times", "rotation"] }
      }
    },
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "sha256", "media_type", "byte_length", "width", "height"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "media_type": { "enum": ["image/jpeg", "image/png", "image/webp"] },
        "byte_length": { "type": "integer", "minimum": 1, "maximum": 20971520 },
        "width": { "type": "integer", "minimum": 320, "maximum": 7680 },
        "height": { "type": "integer", "minimum": 180, "maximum": 7680 }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme_id", "overlay_opacity"],
      "properties": {
        "theme_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "landscape_asset": { "$ref": "#/$defs/assetRef" },
        "portrait_asset": { "$ref": "#/$defs/assetRef" },
        "overlay_opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_sha256", "signing_key_id", "signature_ed25519_base64"],
      "properties": {
        "canonical_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "signing_key_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "signature_ed25519_base64": { "type": "string", "minLength": 80, "maxLength": 120 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/publication-signing-response.schema.json",
  "title": "Isolated Ed25519 signer response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "signing_key_id", "signature_ed25519_base64", "signer_identity", "signed_at", "published_at", "signing_request_sha256", "attestation_ed25519_base64"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_id": { "type": "string", "pattern": "^signing-[0-9a-f]{32}$" },
    "signing_key_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "signature_ed25519_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" },
    "signer_identity": { "type": "string", "minLength": 1, "maxLength": 240 },
    "signed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "previous_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "chain_genesis_reason": { "type": "string", "minLength": 1, "maxLength": 240 },
    "signing_request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "attestation_ed25519_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
  },
  "oneOf": [
    { "required": ["previous_receipt_sha256"], "not": { "required": ["chain_genesis_reason"] } },
    { "required": ["chain_genesis_reason"], "not": { "required": ["previous_receipt_sha256"] } }
  ]
}
